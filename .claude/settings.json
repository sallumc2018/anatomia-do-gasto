{
  "permissions": {
    "allow": [
      "Bash(rtk gain*)",
      "Bash(curl *)",
      "Bash(mkdir -p *)",
      "Bash(chmod +x *)",
      "Bash(xdg-open *)",
      "Bash(kill *)",
      "Bash(pkill *)",
      "Bash(rclone lsd *)",
      "Bash(rclone ls *)",
      "Bash(rclone copy *)",
      "Bash(systemctl --user status *)",
      "Bash(systemctl --user list-units *)",
      "Bash(systemctl status *)",
      "Bash(source ~/.bashrc)",
      "Bash(source ~/.claude/telegram.env)",
      "Bash(source /home/sallumc/.claude/telegram.env)",
      "Bash(bash tools/scripts/pre-push-gate.sh)",
      "Bash(.venv/bin/python3 tools/diagnostico/calc_score.py)",
      "Bash(.venv/bin/python3 pipelines/gerar_datasets_json.py)",
      "Bash(.venv/bin/python3 tools/frontend/generate-mindmap-data.py)",
      "Bash(.venv/bin/python3 tools/agents/check-scope-gates.py)",
      "Bash(.venv/bin/python3 tools/agents/check-commit-gate.py)",
      "Bash(.venv/bin/python3 tools/agents/validate-area.py *)",
      "mcp__claude_ai_Gmail__search_threads",
      "mcp__claude_ai_Gmail__list_drafts",
      "mcp__claude_ai_Gmail__create_draft",
      "mcp__claude_ai_Google_Drive__download_file_content",
      "mcp__claude_ai_Google_Drive__read_file_content",
      "mcp__claude_ai_Google_Drive__search_files",
      "mcp__claude_ai_Google_Drive__get_file_metadata",
      "mcp__claude_ai_Google_Drive__list_recent_files",
      "mcp__claude_ai_Google_Drive__get_file_permissions",
      "mcp__plugin_vercel_vercel__list_deployments",
      "mcp__plugin_vercel_vercel__get_deployment",
      "mcp__plugin_vercel_vercel__get_deployment_build_logs",
      "mcp__plugin_vercel_vercel__web_fetch_vercel_url",
      "mcp__plugin_vercel_vercel__list_teams",
      "mcp__plugin_vercel_vercel__list_projects",
      "mcp__plugin_vercel_vercel__get_project"
    ]
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 tools/hooks/autonomous_rag.py"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "git rev-parse --git-dir >/dev/null 2>&1 && git status --short || true"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 tools/hooks/check_pip_install.py",
            "statusMessage": "Verificando pip vs requirements-audit.txt"
          },
          {
            "type": "command",
            "command": "python3 tools/hooks/check_winget_install.py",
            "statusMessage": "Verificando winget vs requirements-audit.txt"
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 tools/hooks/remind_public_qa.py"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 tools/hooks/check_public_on_stop.py",
            "async": true,
            "asyncRewake": true,
            "rewakeSummary": "verificar_publicacao detectou problema"
          }
        ]
      }
    ]
  }
}
